# Copie para .env e ajuste. Todas as variáveis têm o prefixo DATACHECK_.
DATACHECK_DATABASE_URL=postgresql+psycopg://datacheck:datacheck@localhost:5432/datacheck
DATACHECK_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATACHECK_MAX_UPLOAD_MB=10
DATACHECK_UPLOAD_TTL_MINUTES=60
# Sessão (login opcional). Gere: python -c "import secrets; print(secrets.token_urlsafe(48))"
DATACHECK_SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio-com-mais-de-32-caracteres
DATACHECK_ENVIRONMENT=development
# Em produção (HTTPS) use true
DATACHECK_COOKIE_SECURE=false

# Bases armazenadas para tratamento/EDA (armazenamento privado; só referências ficam no PostgreSQL)
# DATACHECK_DATA_DIR=./data/storage
DATACHECK_DATA_RETENTION_DAYS=30
DATACHECK_MAX_VERSIONS=50
